#version 450
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
layout(local_size_x=64) in;
void main()
{
    uint tile=gl_GlobalInvocationID.x;
    if(tile>=720u) return;
    uint tx=(tile%40u)*32u,ty=(tile/40u)*40u;
    precise vec4 dx=matrix_column(0u)*(1.0/1280.0);
    precise vec4 dy=matrix_column(1u)*(1.0/720.0);
    precise vec4 depth_column=matrix_column(2u)*exp2(-24.0);
    precise vec4 start=matrix_column(0u)*parameter(data[21]+tx/32u)+matrix_column(3u);
    start=matrix_column(1u)*parameter(data[21]+40u+ty/40u)+start;
    vec3 lo=vec3(3.402823e38),hi=vec3(-3.402823e38);
    for(uint ry=0u;ry<40u;ry++)
    {
        precise vec4 row=float(ry)*dy+start;
        for(uint q=0u;q<8u;q++)
        {
            for(uint lane=0u;lane<4u;lane++)
            {
                uint x=tx+31u-4u*q-lane,index=(ty+ry)*W+x;
                uint depth=data[data[19]+index]>>8u;
                precise vec4 p=float(1u+lane)/4.0*(-4.0*dx)+row;
                p=float(depth)*depth_column+p;
                precise vec3 world=p.xyz*estimate(p.w,false);
                position_data[index]=vec4(world,0.0);
                if(depth!=0xffffffu) { lo=min(lo,world); hi=max(hi,world); }
            }
            row=row+(-4.0*dx);
        }
    }
    vec3 centre=(lo+hi)*0.5;
    float sphere_radius=refined_sqrt(dot3(hi-lo,hi-lo))*0.5;
    float left=float(tile%40u)*(2.0/40.0)-1.0,right=float(tile%40u+1u)*(2.0/40.0)-1.0;
    float top=1.0-float(tile/40u)*(2.0/18.0),bottom=1.0-float(tile/40u+1u)*(2.0/18.0);
    vec3 corners[4]=vec3[4](tile_corner(right,top),tile_corner(left,top),tile_corner(left,bottom),tile_corner(right,bottom));
    vec3 planes[4];
    for(uint i=0u;i<4u;i++) planes[i]=refined_normalize(cross(corners[(i+1u)%4u],corners[i]));
    uint mask[MASK_WORDS];
    for(uint i=0u;i<MASK_WORDS;i++) mask[i]=0u;
    if(all(greaterThan(hi,lo)))
    {
        for(uint l=0u;l<data[17];l++)
        {
            vec3 lp=light_vector(l,0u),closest=clamp(lp,lo,hi);
            float radius=light_value(l,8u);
            if(dot3(lp-closest,lp-closest)>=radius*radius) continue;
            bool plane_hit=true;
            for(uint i=0u;i<4u;i++) if(dot3(planes[i],lp)+radius<0.0) plane_hit=false;
            if(!plane_hit) continue;
            if(light_kind(l)==2u && !cone_sphere(centre,sphere_radius,lp,radius,light_vector(l,12u),light_value(l,10u))) continue;
            bool found=false;
            for(uint ry=0u;ry<40u && !found;ry++)
                for(uint x=tx;x<tx+32u && !found;x++)
                {
                    vec3 delta=lp-position_data[(ty+ry)*W+x].xyz;
                    float dsq=dot3(delta,delta);
                    if(dsq>=radius*radius) continue;
                    if(light_kind(l)==2u)
                    {
                        float inv=estimate(dsq,true),dist=dsq*inv;
                        float angle=dot3(delta,-light_vector(l,12u))*inv;
                        if(dist>=radius || angle<=light_value(l,10u)) continue;
                    }
                    found=true;
                }
            if(found) mask[l/32u]|=1u<<(l%32u);
        }
    }
    for(uint i=0u;i<MASK_WORDS;i++) tile_data[MASK_WORDS*tile+i]=mask[i];
}
