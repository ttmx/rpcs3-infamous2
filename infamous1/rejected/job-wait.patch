 #include "Crypto/sha1.h"
@@ -4964,6 +4965,7 @@ bool ppu_initialize(const ppu_module<lv2_obj>& info, bool check_only, u64 file_s
 			{ "__resupdate", reinterpret_cast<u64>(vm::reservation_update) },
