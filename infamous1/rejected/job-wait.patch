diff --git a/rpcs3/Emu/Cell/PPUInfamousJobWait.h b/rpcs3/Emu/Cell/PPUInfamousJobWait.h
new file mode 100644
index 000000000..159b49908
--- /dev/null
+++ b/rpcs3/Emu/Cell/PPUInfamousJobWait.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "util/types.hpp"
+
+class ppu_thread;
+
+// inFamous (BCES00609 v1.00): the function at 0x41fc38 waits for the game's worker threads in a spin loop. It calls
+// the function at 0x41d028 until that returns true: the smallest of seven 16-bit counters, one per worker, has
+// reached a target. On the console the loop has a core to itself; here it keeps a host core at full speed for about
+// a third of every frame.
+//
+// The nop at 0x41fc70, right after the poll, calls wait(): if the poll said no, the thread waits for a write to the
+// cache line of the counters (MONITORX/MWAITX), or a short time, and then the loop polls again as before. While it
+// waits the thread counts as paused, like in a system call, so that other threads' memory locks do not wait for it.
+// The other three callers of the poll do work between polls and are left alone.
+// RPCS3_INFAMOUS1_JOB_WAIT: 0 = off, otherwise the longest single wait in microseconds (default 50).
+namespace infamous1_job_wait
+{
+	constexpr u32 hook_address = 0x41fc70;
+
+	// The title, the switch and the bytes of both functions all match
+	bool enabled();
+
+	// object: the first argument of the waiting function (r30), target: the count to reach (r31), result: what the
+	// poll returned (r3)
+	void wait(ppu_thread& ppu, u32 object, u32 target, u32 result);
+}
